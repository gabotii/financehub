# Copy to .env and adjust. Never commit .env.
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

POSTGRES_DB=financehub
POSTGRES_USER=financehub
POSTGRES_PASSWORD=financehub

# Used when running Django from the host venv; compose overrides it with host "db".
DATABASE_URL=postgres://financehub:financehub@localhost:5432/financehub
